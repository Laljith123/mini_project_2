# AWS Elastic Beanstalk configuration for the Admission Enquiry Assistant
# Deployed as:  eb deploy  (Docker platform, single instance for cost efficiency)
option_settings:
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
  aws:elasticbeanstalk:application:environment:
    # The OpenAI API key is injected as an *environment property* by
    # Elastic Beanstalk (secret management - never stored in the image).
    OPENAI_MODEL: gpt-4o-mini
    PORT: 8000
  aws:elasticbeanstalk:application:healthcheck:
    # The /health endpoint returns {"status": "ok"} for load-balancer probes.
    Path: /health
    ResponseCode: 200
  aws:autoscaling:launchconfiguration:
    # Security group allows HTTP (80) only; SSH restricted to the
    # administrator's IP via the AWS console.
    SecurityGroups: admission-assistant-sg
    InstanceType: t3.small
